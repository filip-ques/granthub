<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container zone">
  <%- include('menu', { active: 'deminimis' }) %>
  <div>
    <h1 style="font-size:1.7rem">De minimis kalkulačka</h1>
    <p class="muted">Pomoc malého rozsahu podľa nariadenia (EÚ) 2023/2831: limit <strong>300 000 €</strong> pre jediný podnik za ľubovoľné 3 kĺzavé roky. Evidujte každú prijatú minimálnu pomoc (dotácie, vouchery, zvýhodnené úvery) vrátane prepojených firiem.</p>
    <p class="form-note">Na výpočet čerpanej minimálnej pomoci (de minimis) použijeme vami zadané IČO a údaje z oficiálneho centrálneho registra IS SEMP. Výsledok má informatívny charakter podľa nariadenia (EÚ) 2023/2831 a nenahrádza záväzné potvrdenie poskytovateľa pomoci. Spracúvanie údajov podrobnejšie opisujú <a href="/ochrana-osobnych-udajov">Zásady ochrany osobných údajov</a>.</p>

    <% if (savedMsg) { %><div class="alert alert-success" role="alert"><strong>Uložené.</strong></div><% } %>
    <% if (refreshing) { %>
      <div class="alert alert-info" role="alert">
        <strong>Načítavame vašu pomoc z registra IS SEMP…</strong> pre IČO <span class="mono"><%= ico %></span>.
        Obnovte stránku o pár sekúnd — dáta sa dopĺňajú na pozadí, aby web ostal rýchly.
      </div>
    <% } %>

    <div class="kpis" style="grid-template-columns:repeat(3,1fr);margin-bottom:1.3rem">
      <div class="kpi"><div class="num"><%= drawn.toLocaleString('sk-SK', {maximumFractionDigits: 0}) %> €</div><div class="lbl">čerpané v 3-ročnom okne (od <%= fmtDate(cutoff) %>)</div></div>
      <div class="kpi" style="border-top-color:<%= remaining > 50000 ? 'var(--success)' : 'var(--error)' %>"><div class="num"><%= remaining.toLocaleString('sk-SK', {maximumFractionDigits: 0}) %> €</div><div class="lbl">zostávajúci priestor do limitu</div></div>
      <div class="kpi"><div class="num"><%= Math.round(drawn / limit * 100) %> %</div><div class="lbl">vyčerpané z 300 000 €</div></div>
    </div>
    <% if (remaining < 50000) { %>
      <div class="alert alert-error" role="alert"><strong>Pozor:</strong> blížite sa k stropu de minimis. Pomoc nad limit sa vracia aj s úrokmi — pred podaním žiadosti si overte presný stav.</div>
    <% } %>

    <% if (ico) { %>
      <div class="alert alert-info" role="alert" style="margin-bottom:1.3rem">
        <strong>Automaticky z registra IS SEMP:</strong> pre IČO <span class="mono"><%= ico %></span><% if (linked.length) { %> a prepojené firmy (<strong><%= linked.length %></strong>)<% } %> evidujeme <strong><%= registryCount %></strong> záznamov prijatej minimálnej pomoci. Register aktualizujeme raz týždenne. Zmeniť IČO môžete v <a href="/ucet">profile</a>.
      </div>
    <% } else { %>
      <div class="alert alert-info" role="alert" style="margin-bottom:1.3rem">
        Zadajte IČO svojej firmy v <a href="/ucet">profile účtu</a> — automaticky sem načítame vaše čerpanie de minimis z oficiálneho registra, bez hľadania.
      </div>
    <% } %>

    <div class="panel" style="margin-bottom:1.3rem">
      <div class="panel-head" style="margin-bottom:.4rem">
        <h2 style="font-size:1.2rem;margin:0">Prepojené firmy (jediný podnik)</h2>
        <% if (linked.length) { %><span class="small muted"><%= linked.length %> <%= linked.length === 1 ? 'prepojená firma' : (linked.length < 5 ? 'prepojené firmy' : 'prepojených firiem') %></span><% } %>
      </div>
      <p class="small muted">Limit 300 000 € neplatí pre firmu, ale pre celý „jediný podnik“ — teda spoločnosti prepojené väčšinovým podielom, hlasovacími právami, spoločným vedením či rozhodujúcim vplyvom. Pridajte ich IČO a ich čerpanie z registra IS SEMP započítame do spoločného limitu vyššie.</p>

      <table class="t t--cards">
        <thead><tr><th>Firma</th><th>IČO</th><th>Prepojenie</th><th>Čerpané v okne</th><th data-label=""></th></tr></thead>
        <tbody>
          <tr>
            <td data-label="Firma"><strong><%= company || 'Moja firma' %></strong></td>
            <td data-label="IČO" class="mono"><%= ico || '—' %></td>
            <td data-label="Prepojenie"><span class="badge-stage s-won">moja firma</span></td>
            <td data-label="Čerpané v okne"><%= fmtEur(drawnByIco[ico] || 0) %></td>
            <td data-label=""><a class="btn btn-ghost btn-sm" href="/ucet">Upraviť IČO</a></td>
          </tr>
          <% for (const l of linked) { %>
            <tr>
              <td data-label="Firma"><%= l.name || '—' %></td>
              <td data-label="IČO" class="mono"><%= l.ico %></td>
              <td data-label="Prepojenie"><span class="small muted"><%= l.relation || 'prepojená firma' %></span></td>
              <td data-label="Čerpané v okne"><%= fmtEur(drawnByIco[l.ico] || 0) %></td>
              <td data-label=""><form method="post" action="/ucet/deminimis/prepojene/<%= l.id %>/zmazat" data-confirm="Odobrať prepojenú firmu?"><button class="btn btn-danger btn-sm">Odobrať</button></form></td>
            </tr>
          <% } %>
        </tbody>
      </table>

      <form method="post" action="/ucet/deminimis/prepojene" style="margin-top:1rem">
        <div class="field-row">
          <div class="field">
            <label for="l-ico">IČO prepojenej firmy *</label>
            <input id="l-ico" name="ico" type="text" inputmode="numeric" pattern="[0-9 ]{6,12}" required>
          </div>
          <div class="field">
            <label for="l-name">Názov firmy</label>
            <input id="l-name" name="name" type="text" autocomplete="organization">
            <div class="hint">Ak necháte prázdne, doplníme ho z registra IS SEMP.</div>
          </div>
        </div>
        <div class="field">
          <label for="l-relation">Typ prepojenia</label>
          <input id="l-relation" name="relation" type="text" placeholder="napr. materská spoločnosť, spoločný väčšinový spoločník">
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Pridať prepojenú firmu</button>
      </form>
    </div>

    <% if (!aids.length) { %>
      <div class="empty"><h3>Žiadne záznamy pre toto IČO</h3><p><% if (ico) { %>V centrálnom registri IS SEMP zatiaľ pre IČO <span class="mono"><%= ico %></span> neevidujeme žiadnu minimálnu pomoc. Register aktualizujeme raz týždenne.<% } else { %>Zadajte IČO svojej firmy v <a href="/ucet">profile</a> a automaticky sem načítame vaše čerpanie z registra.<% } %></p></div>
    <% } else { %>
      <table class="t t--cards">
        <thead><tr><th>Dátum</th><th>Poskytovateľ</th><% if (linked.length) { %><th>Firma</th><% } %><th>Suma</th><th>V okne</th></tr></thead>
        <tbody>
          <% for (const a of aids) { const inW = new Date(a.granted_at) >= cutoff;
             const scheme = (a.scheme_code || '').match(/\d{3,4}\/\d{4}/) ? 'de minimis ' + a.scheme_code.match(/\d{3,4}\/\d{4}/)[0] : (a.note || ''); %>
            <tr>
              <td data-label="Dátum" class="nowrap"><%= fmtDate(a.granted_at) %></td>
              <td data-label="Poskytovateľ"><%= a.provider %>
                <br><span class="small muted"><%= scheme %><% if (a.source === 'manual') { %> · ručne<% } %></span></td>
              <% if (linked.length) { %><td data-label="Firma" class="small"><%= a.company || '—' %><br><span class="mono muted"><%= a.ico || '' %></span></td><% } %>
              <td data-label="Suma"><strong><%= Number(a.amount_eur).toLocaleString('sk-SK') %> €</strong></td>
              <td data-label="V okne"><span class="badge-stage <%= inW ? 's-preparing' : 's-won' %>"><%= inW ? 'počíta sa' : 'mimo okna' %></span>
                <% if (a.source === 'manual') { %><form method="post" action="/ucet/deminimis/<%= a.id %>/zmazat" data-confirm="Zmazať záznam?" style="display:inline;margin-left:.4rem"><button class="btn btn-danger btn-sm">Zmazať</button></form><% } %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
    <p class="small muted">Kalkulačka je orientačná pomôcka, nie právne záväzný výpočet — rozhodujúca je evidencia v IS SEMP a čestné vyhlásenie. Limit platí za „jediný podnik“ (prepojené firmy spolu); pre cestnú nákladnú dopravu platia osobitné pravidlá.</p>
  </div>
</div>
<%- include('../partials/footer') %>
